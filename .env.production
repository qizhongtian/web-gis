# ---------------------------------------------------------------
# GitHub Pages 部署配置
# 仓库为 project 站点时地址是 https://<user>.github.io/<repo>/，
# 所以 VITE_BASE 必须等于「/<仓库名>/」。
# CI 里会用 ${{ github.event.repository.name }} 覆盖，改名后无需改这里。
# ---------------------------------------------------------------
VITE_BASE = /web-gis/

# 纯静态托管没有后端：启用内置静态 Mock（登录 admin / 123456、viewer / 123456）
# 接真实后端时删掉这一行，并把 VITE_API_BASE 指向后端地址
VITE_STATIC_MOCK = 1

# 香港 DEM 地形地址。源站 https://bk.mediumvis.com:8090 的 CORS 头重复，浏览器直连会被拦截，
# GitHub Pages 又无法自带反向代理，所以生产环境需要一个外部反代（见 deploy/terrain-proxy）。
# CI 会用仓库变量 vars.VITE_HK_TERRAIN_URL 覆盖这里，通常无需改动本文件；
# 本地打包验证时可以取消注释并填自己的 Worker 地址：
# VITE_HK_TERRAIN_URL = https://web-gis-terrain-proxy.<account>.workers.dev/gis/SMPstatic/20251011HKdemqp

# ---------------------------------------------------------------
# GitHub Pages 部署配置
# 仓库为 project 站点时地址是 https://<user>.github.io/<repo>/，
# 所以 VITE_BASE 必须等于「/<仓库名>/」。
# CI 里会用 ${{ github.event.repository.name }} 覆盖，改名后无需改这里。
# ---------------------------------------------------------------
VITE_BASE = /web-gis/

# 纯静态托管没有后端：启用内置静态 Mock（登录 admin / 123456、viewer / 123456）
# 接真实后端时删掉这一行，并把 VITE_API_BASE 指向后端地址
VITE_STATIC_MOCK = 1

# 香港 DEM 地形地址（生产环境无法使用 dev 代理，需要能跨域的地址；
# 源站 CORS 头重复时会被浏览器拦截，可换自建反向代理或留空使用默认全球地形）
# VITE_HK_TERRAIN_URL = https://bk.mediumvis.com:8090/gis/SMPstatic/20251011HKdemqp

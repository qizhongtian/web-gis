# ---------------------------------------------------------------
# GitHub Pages 部署配置
# 仓库为 project 站点时地址是 https://<user>.github.io/<repo>/，
# 所以 VITE_BASE 必须等于「/<仓库名>/」。
# CI 里会用 ${{ github.event.repository.name }} 覆盖，改名后无需改这里。
# ---------------------------------------------------------------
VITE_BASE = /web-gis/

# 纯静态托管没有后端：启用内置静态 Mock（登录 admin / 123456、viewer / 123456）
# 接真实后端时删掉这一行，并把 VITE_API_BASE 指向后端地址
VITE_STATIC_MOCK = 1

# 地形服务默认使用全球高程（ArcGIS World Elevation 3D，免密钥、可直接跨域），无需配置。
# 如需换成自建 quantized-mesh 或反代地址，取消下面注释并填写（CI 里也支持仓库变量 vars.VITE_HK_TERRAIN_URL 覆盖）：
# VITE_HK_TERRAIN_URL = https://your-terrain-host/gis/terrain

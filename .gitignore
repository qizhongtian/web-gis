# 个人本地覆盖请写到 .env.local / .env.*.local，不入库
.env.local
.env.*.local
*.local

# ---------- 日志 ----------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- 测试 / 调试产物 ----------
.playwright-cli/
test-results/
playwright-report/
blob-report/
coverage/

# ---------- 临时文件 ----------
.tmp-*
*.tmp
.cache/
temp/

